generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// One row per quiz session (browser visit)
model QuizSession {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())
  completedAt DateTime?
  email       String?
  status      String   @default("in_progress") // in_progress | completed | converted
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  userAgent   String?

  answers   QuizAnswer[]
  events    SessionEvent[]

  @@map("quiz_sessions")
}

// One row per answer (single or multi-select)
model QuizAnswer {
  id             String   @id @default(cuid())
  sessionId      String
  questionNumber Int
  questionType   String   // "question" | "intro"
  question       String?  // full question text
  answerIds      String[] // one or more selected option ids
  answeredAt     DateTime @default(now())

  session QuizSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@map("quiz_answers")
}

// Pixel / funnel events (FirstInteraction, 5Interaction, etc.)
model SessionEvent {
  id        String   @id @default(cuid())
  sessionId String
  event     String   // e.g. "FirstInteraction", "EmailCaptured", "WheelSpun"
  metadata  Json?
  createdAt DateTime @default(now())

  session QuizSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@map("session_events")
}
